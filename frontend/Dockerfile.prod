# Build stage
FROM node:24-alpine AS build

WORKDIR /app

# API_BASE_URL is compiled into the bundle by quasar.config.js (build.env), so
# it has to be known here -- it cannot be changed by an env var at run time.
ARG API_BASE_URL=http://localhost:8000
ENV API_BASE_URL=$API_BASE_URL

# Quasar's prepare script (postinstall) needs the source present, so copy
# everything before installing.
COPY package*.json ./
COPY . .
RUN npm install --no-audit --no-fund

RUN npm run build

# Serve stage
FROM nginx:1.27-alpine

COPY --from=build /app/dist/spa /usr/share/nginx/html
# Replaces the default server block entirely; it already listens on 8080 so the
# container can run as a non-root user.
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
